        {
            "parameters": {
                "jsCode": "for (const item of $input.all()) {\n  const output = item.json.output || {};\n  const axiom = output.axiom || '';\n  const radicals = output.radicals || [];\n  const falsability = output.falsability || '';\n\n  // 1. AXIOM not empty\n  const axiom_ok = axiom.trim().length > 5;\n\n  // 2. Formal Radicals + Min 2\n  const allowed = [\"Obligation\", \"Metric\", \"Contingency\", \"Risk\", \"Asset\", \"Exception\"];\n  const radicals_ok = radicals.length >= 2 && radicals.every(r => allowed.includes(r.radical));\n\n  // 3. Cartesian Guard (No Axis:Value collisions)\n  const pairs_set = new Set();\n  let cartesian_ok = true;\n  for (const r of radicals) {\n    const pair = `${r.radical}:${r.value}`;\n    if (pairs_set.has(pair)) {\n      cartesian_ok = false;\n      break;\n    }\n    pairs_set.add(pair);\n  }\n\n  // 4. Flex-Falsifiability (Technical Exception Rule)\n  const falsability_ok = (radicals.some(r => r.radical === 'Exception')) ? \n    true : (falsability.trim().length > 5 && !falsability.includes('none'));\n\n  // TRIDENT Consensus\n  const trident = {\n    explorer: radicals_ok ? '✓' : '✗',\n    auditor: axiom_ok ? '✓' : '✗',\n    guardian: cartesian_ok ? '✓' : '✗'\n  };\n  \n  const and_gate = trident.explorer === '✓' && trident.auditor === '✓' && trident.guardian === '✓';\n  \n  item.json = { \n    ...item.json, \n    axiom_ok, \n    radicals_ok, \n    cartesian_ok, \n    falsability_ok, \n    trident_status: `${trident.explorer}${trident.auditor}${trident.guardian}`, \n    and_gate_ok: and_gate, \n    debug: trident \n  };\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                208,
                960
            ],

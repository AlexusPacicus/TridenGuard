    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"case_id\": \"{{ $json.case_id }}\", \"status\": \"{{ $json.status }}\", \"rejection_reason\": \"{{ $json.rejection_reason }}\", \"severity\": \"{{ $json.has_critical ? 'CRITICAL' : ($json.has_warning ? 'WARNING' : 'UNKNOWN') }}\"}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,

# TridenGuard Environment Variables Example
# Copy this to .env and change the values for production

# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Security & Auth
API_KEY=tridenguard_secret_key_2026
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123

# AI Engine (Ollama)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=phi4-mini:3.8b

# Lobster Trap
LOBSTER_TRAP_POLICY=/data/tridenguard/configs/default_policy.yaml
